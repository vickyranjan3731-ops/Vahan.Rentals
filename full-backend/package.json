{
  "name": "vahan-rentals-backend",
  "version": "1.0.0",
  "description": "Full Backend for Vahan.Rentals using Turso DB (LibSQL) and Firebase Auth/Admin SDK",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js"
  },
  "keywords": [
    "turso",
    "libsql",
    "firebase",
    "express",
    "vahan-rentals"
  ],
  "author": "Vahan.Rentals Team",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "imagekit": "^6.0.0",
    "morgan": "^1.10.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9"
  }
}
